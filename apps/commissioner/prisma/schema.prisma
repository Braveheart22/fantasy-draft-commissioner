generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model SchemaMetadata {
  singleton Int @id @default(1)
  version Int
  applicationVersion String
}
model League {
  id String @id
  name String
  seasons Season[]
  teams Team[]
}
model Season {
  id String @id
  leagueId String
  league League @relation(fields: [leagueId], references: [id])
  year Int
  name String
  state String
  teamCount Int
  rowVersion Int @default(0)
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seasonTeams SeasonTeam[]
  auditEvents AuditEvent[]
  snapshots FrozenSnapshot[]
  checkpoints Checkpoint[]
  players Player[]
  importBatches PlayerImportBatch[]
  priceFloors PositionPriceFloor[]
  keepers KeeperSelection[]
  auctionRounds AuctionRound[]
  @@unique([leagueId, year])
}
model Team {
  id String @id
  leagueId String
  league League @relation(fields: [leagueId], references: [id])
  franchiseName String
  seasons SeasonTeam[]
}
model SeasonTeam {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  teamId String
  team Team @relation(fields: [teamId], references: [id])
  displayName String
  seedOrder Int
  active Boolean @default(true)
  @@unique([seasonId, teamId])
  @@unique([seasonId, seedOrder])
  keeper KeeperSelection?
}
model Player {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  name String
  position String
  sourceType String
  sourceNamespace String?
  externalId String?
  custom Boolean @default(false)
  explicitMinimumBid Int?
  available Boolean @default(true)
  keeperEligible Boolean @default(false)
  activeImportBatchId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  keeper KeeperSelection?
  @@unique([seasonId, sourceType, sourceNamespace, externalId])
}
model PlayerImportBatch {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  sourceNamespace String
  format String
  sha256 String
  rowCount Int
  supersedesId String?
  supersededAt DateTime?
  createdAt DateTime @default(now())
  @@unique([seasonId, sourceNamespace, sha256])
}
model PositionPriceFloor {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  position String
  minimumBid Int
  @@unique([seasonId, position])
}
model KeeperSelection {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  seasonTeamId String @unique
  seasonTeam SeasonTeam @relation(fields: [seasonTeamId], references: [id])
  playerId String @unique
  player Player @relation(fields: [playerId], references: [id])
  cost Int @default(50)
  startingBudget Int
  createdAt DateTime @default(now())
}
model AuctionRound {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  roundNumber Int
  status String
  inputSnapshotId String?
  inputHash String?
  contractVersion String?
  publishedAt DateTime?
  supersededAt DateTime?
  submissions AuctionSubmission[]
  attempts AuctionAttempt[]
  decisions AuctionTieDecision[]
  awards AuctionAward[]
  @@unique([seasonId, roundNumber, supersededAt])
}
model AuctionSubmission {
  id String @id
  roundId String
  round AuctionRound @relation(fields: [roundId], references: [id])
  seasonTeamId String
  status String
  zeroConfirmed Boolean @default(false)
  bidsJson String
  bidCount Int
  updatedAt DateTime @updatedAt
  @@unique([roundId, seasonTeamId])
}
model AuctionAttempt {
  id String @id
  roundId String
  round AuctionRound @relation(fields: [roundId], references: [id])
  attemptNumber Int
  inputJson String
  inputHash String
  outputJson String
  outputHash String
  eliminationsJson String
  traceJson String
  status String
  contractVersion String
  createdAt DateTime @default(now())
  supersededAt DateTime?
  @@unique([roundId, attemptNumber])
}
model AuctionTieDecision {
  id String @id
  roundId String
  round AuctionRound @relation(fields: [roundId], references: [id])
  tieKey String
  playerId String
  amount Int
  participantTeamIdsJson String
  preferredTeamId String
  method String
  note String?
  decidedAt DateTime
  supersededAt DateTime?
}
model AuctionAward {
  id String @id
  roundId String
  round AuctionRound @relation(fields: [roundId], references: [id])
  seasonTeamId String
  playerId String
  amount Int
  bidId String
  sourceAttemptId String
  @@unique([roundId, playerId])
}
model TeamAuctionBalance {
  id String @id
  seasonId String
  seasonTeamId String
  roundNumber Int
  startingBudget Int
  spent Int
  remainingBudget Int
  @@unique([seasonId, seasonTeamId, roundNumber])
}
model RosterAssignment {
  id String @id
  seasonId String
  seasonTeamId String
  playerId String
  acquisitionSource String
  auctionRound Int?
  cost Int?
  sourceEntityId String
  supersededAt DateTime?
  @@unique([seasonId, playerId, supersededAt])
}
model AuditEvent {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  sequence Int
  actorType String
  actorLabel String
  commandType String
  entityType String?
  entityId String?
  correlationId String
  idempotencyKey String
  reason String?
  beforeJson String?
  afterJson String?
  resultJson String?
  createdAt DateTime @default(now())
  snapshots FrozenSnapshot[]
  checkpoints Checkpoint[]
  @@unique([seasonId, sequence])
  @@unique([seasonId, actorType, idempotencyKey])
}
model FrozenSnapshot {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  kind String
  schemaVersion Int
  payloadJson String
  sha256 String
  createdAt DateTime @default(now())
  sourceAuditEventId String
  sourceAuditEvent AuditEvent @relation(fields: [sourceAuditEventId], references: [id])
  checkpoints Checkpoint[]
}
model Checkpoint {
  id String @id
  seasonId String
  season Season @relation(fields: [seasonId], references: [id])
  kind String
  seasonVersion Int
  stateSnapshotId String
  stateSnapshot FrozenSnapshot @relation(fields: [stateSnapshotId], references: [id])
  sourceAuditEventId String
  sourceAuditEvent AuditEvent @relation(fields: [sourceAuditEventId], references: [id])
  createdAt DateTime @default(now())
  supersededAt DateTime?
}
